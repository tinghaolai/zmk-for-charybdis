#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>


&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        escc {
            bindings = <&kp ESC>;
            key-positions = <17 18>;
            layers = <0>;
        };
    };

    macros {
        pwd_macro: pwd_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp EXCL &kp LS(A) &kp N &kp A &kp L &kp T &kp H &kp N0 &kp N9 &kp N2 &kp N6 &kp N3 &kp N7>,
                <&macro_press>;

            label = "PWD_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC       &kp COMMA             &kp AMPERSAND  &kp LEFT_BRACKET          &kp LEFT_BRACE   &kp GRAVE  &pwd_macro      &kp BACKSLASH  &kp QUESTION   &kp COLON     &kp PERIOD                 &kp ASTERISK  &kp MINUS  &none
&lt 1 CAPS    &kp DOLLAR            &kp EQUAL      &kp SEMICOLON             &kp P            &kp Y      &none           &kp SLASH      &kp F          &kp G         &kp C                      &kp R         &kp L      &none
&kp LEFT_GUI  &kp A                 &kp O          &kp E                     &kp U            &kp I      &none           &kp SQT        &kp D          &kp H         &kp T                      &kp N         &kp S      &none
&kp TAB       &kp Q                 &kp Q          &kp J                     &kp K            &kp X      &none           &mo 6          &kp B          &kp M         &kp W                      &kp V         &kp Z      &none
&sl 3         &kp LG(LS(NUMBER_4))  &kp AT         &kp LEFT_ARROW            &kp RIGHT_ARROW  &kp SPACE  &kp D           &kp ENTER      &kp BACKSPACE  &kp UP_ARROW  &kp DOWN_ARROW             &kp PERCENT   &none      &none
                                                   &kp LA(LC(LEFT_BRACKET))  &kp NUMBER_7     &mo 5      &kp NUMBER_4    &kp NUMBER_9   &kp NUMBER_7   &kp NUMBER_0  &kp LC(LA(RIGHT_BRACKET))
            >;
        };

        layer_1 {
            bindings = <
&none        &kp EXCLAMATION  &kp HASH   &kp RIGHT_BRACKET   &kp RIGHT_BRACE  &kp TILDE       &none     &kp LS(NUMBER_6)   &none      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS   &kp LS(UNDERSCORE)  &none
&none        &kp RG(F)        &kp RG(C)  &kp RG(V)           &kp LS(P)        &kp LS(Y)       &none     &none              &kp LS(F)  &kp LS(G)             &kp LS(C)              &kp LS(R)  &kp LS(L)           &none
&none        &kp LS(A)        &kp LS(O)  &kp LS(E)           &kp LS(U)        &kp LS(I)       &none     &kp DOUBLE_QUOTES  &kp LS(D)  &kp LS(H)             &kp LS(T)              &kp LS(N)  &kp LS(S)           &none
&kp LS(TAB)  &kp LS(Q)        &kp LS(Q)  &kp LS(J)           &kp LS(K)        &kp LS(X)       &none     &kp PIPE           &kp LS(B)  &kp LS(M)             &kp LS(W)              &kp LS(V)  &kp LS(Z)           &none
&none        &none            &none      &kp LS(LEFT_ARROW)  &kp LS(RIGHT)    &kp LEFT_SHIFT  &trans    &kp LS(ENTER)      &trans     &kp LS(UP_ARROW)      &kp LS(DOWN_ARROW)     &none      &none               &none
                                         &trans              &bootloader      &trans          &trans    &none              &none      &none                 &none
            >;
        };

        layer_2 {
            bindings = <
&none             &none         &none         &none         &none         &none         &rgb_ug RGB_TOG    &bt BT_NXT     &bt BT_CLR     &none         &none         &none         &none         &none
&kp LEFT_SHIFT    &none         &none         &none         &none         &none         &rgb_ug RGB_EFF    &none          &none          &none         &none         &none         &none         &none
&none             &kp NUMBER_7  &kp NUMBER_5  &kp NUMBER_3  &kp NUMBER_1  &kp NUMBER_9  &rgb_ug RGB_BRI    &none          &kp NUMBER_0   &kp NUMBER_2  &kp NUMBER_4  &kp NUMBER_6  &kp NUMBER_8  &none
&none             &none         &none         &none         &none         &none         &rgb_ug RGB_BRD    &none          &kp PAGE_UP    &kp HOME      &kp END       &none         &none         &none
&kp LEFT_CONTROL  &none         &none         &none         &none         &none         &none              &kp BACKSPACE  &kp PAGE_DOWN  &none         &none         &none         &none         &bootloader
                                              &none         &none         &none         &none              &none          &kp BACKSPACE  &none         &none
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans        &mkp MB3   &trans         &trans     &bootloader    &bl BL_ON  &bl BL_OFF     &bl BL_INC  &bl BL_DEC  &trans  &trans      &kp LG(A)
&trans  &trans  &kp LC(LEFT)  &kp F21    &kp LG(RIGHT)  &trans     &trans         &none      &none          &none       &kp F15     &none   &none       &kp LG(F)
&trans  &trans  &kp F19       &kp F20    &kp F18        &trans     &trans         &none      &none          &kp F13     &kp F14     &kp F6  &trans      &kp LG(C)
&trans  &kp AT  &trans        &kp LC(W)  &trans         &trans     &trans         &trans     &kp PAGE_UP    &kp HOME    &kp END     &trans  &kp K_UNDO  &kp LG(V)
&trans  &trans  &none         &kp LS(J)  &kp LS(K)      &mkp LCLK  &mkp RCLK      &kp F17    &kp PAGE_DOWN  &sl 4       &trans      &trans  &trans      &trans
                              &trans     &none          &sl 4      &trans         &kp F16    &trans         &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp F1  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F3  &kp F2  &kp F4  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp LC(C)    &kp F13        &kp F14  &kp F15        &kp F17                &kp F16      &trans    &trans            &trans            &trans            &trans            &kp LS(LG(GRAVE))         &kp LG(GRAVE)              &trans
&trans       &kp F18        &kp F20  &kp LESS_THAN  &kp GREATER_THAN       &kp LC(Y)    &trans    &trans            &trans            &trans            &kp LA(C)         &kp LC(LA(LEFT_BRACKET))  &kp LA(LC(RIGHT_BRACKET))  &trans
&trans       &kp LG(COMMA)  &trans   &trans         &kp LA(RIGHT_BRACKET)  &kp LA(SQT)  &trans    &kp LA(NUMBER_0)  &kp LC(D)         &trans            &trans            &trans                    &kp LA(S)                  &trans
&kp LG(TAB)  &trans         &trans   &trans         &trans                 &trans       &trans    &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)          &kp LA(NUMBER_6)           &trans
&none        &trans         &trans   &kp LA(LEFT)   &kp LA(RIGHT)          &trans       &trans    &kp LEFT_GUI      &kp LA(NUMBER_7)  &kp LA(NUMBER_8)  &kp LA(NUMBER_9)  &kp LA(NUMBER_0)          &trans                     &trans
                                     &trans         &trans                 &trans       &trans    &trans            &trans            &trans            &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &kp LG(BACKSLASH)  &trans         &trans        &trans        &trans        &trans        &bootloader
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &trans             &trans         &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_7  &kp NUMBER_5  &kp NUMBER_3  &kp NUMBER_1  &kp NUMBER_9  &trans    &trans             &kp NUMBER_0   &kp NUMBER_2  &kp NUMBER_4  &kp NUMBER_6  &kp NUMBER_8  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &trans             &kp PAGE_UP    &kp HOME      &kp END       &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans    &trans             &kp PAGE_DOWN  &trans        &trans        &trans        &trans        &trans
                                    &trans        &trans        &trans        &trans    &trans             &trans         &trans        &trans
            >;
        };

        /*  layer_3 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none    &none  &none  &none   &kp FSLH  &kp ASTERISK  &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &kp N7  &kp N8    &kp N9        &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &kp N4  &kp N5    &kp N6        &none  &none
&none  &none  &none  &none  &none  &none  &to 0    &to 3  &none  &kp N1  &kp N2    &kp N3        &none  &none
&none  &none  &none  &none  &none  &none  &to 1    &none  &none  &none   &kp N0    &none         &none  &none
                                   &none  &to 2    &none  &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
          trackball-bindings = <&tsl>;
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
                trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;
                
        };*/
    };
};

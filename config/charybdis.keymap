#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC       &kp COMMA             &kp AMPERSAND     &kp LEFT_BRACKET          &kp LEFT_BRACE   &kp LESS_THAN  &kp GRAVE               &kp NON_US_BACKSLASH  &kp QUESTION   &kp COLON     &kp PERIOD                 &kp PIPE     &kp ASTERISK  &kp MINUS
&lt 1 CAPS    &kp DOLLAR            &kp EQUAL         &kp SEMICOLON             &kp P            &kp Y          &kp LEFT_PARENTHESIS    &kp SLASH             &kp F          &kp G         &kp C                      &kp R        &kp L         &kp PLUS
&kp LEFT_GUI  &kp A                 &kp O             &kp E                     &kp U            &kp I          &kp SQT                 &kp DEL               &kp D          &kp H         &kp T                      &kp N        &kp S         &sl 2
&kp TAB       &kp AT_SIGN           &kp Q             &kp J                     &kp K            &kp X          &none                   &none                 &kp B          &kp M         &kp W                      &kp V        &kp Z         &none
&sl 3         &kp LG(LS(NUMBER_4))  &kp LEFT_CONTROL  &kp LEFT_ARROW            &kp RIGHT_ARROW  &kp SPACE      &kp LEFT_ALT            &kp N7                &kp ENTER      &kp UP_ARROW  &kp DOWN_ARROW             &kp PERCENT  &none         &mo 2
                                                      &kp LA(LC(LEFT_BRACKET))  &kp NUMBER_6     &kp NUMBER_2   &kp NUMBER_4            &kp NUMBER_9          &kp BACKSPACE  &kp NUMBER_0  &kp LC(LA(RIGHT_BRACKET))
            >;
        };

        layer_1 {
            bindings = <
&none  &kp EXCLAMATION  &kp HASH   &kp RIGHT_BRACKET   &kp RIGHT_BRACE  &kp GREATER_THAN  &kp TILDE                &none            &none          &none             &none               &none      &kp LCTRL  &kp UNDERSCORE
&none  &kp RG(F)        &kp RG(C)  &kp RG(V)           &kp LS(P)        &kp LS(Y)         &kp RIGHT_PARENTHESIS    &kp RIGHT_BRACE  &kp LS(F)      &kp LS(G)         &kp LS(C)           &kp LS(R)  &kp LS(L)  &none
&none  &kp LS(A)        &kp LS(O)  &kp LS(E)           &kp LS(U)        &kp LS(I)         &kp DOUBLE_QUOTES        &none            &kp LS(D)      &kp LS(H)         &kp LS(T)           &kp LS(N)  &kp LS(S)  &none
&none  &none            &kp LS(Q)  &kp LS(J)           &kp LS(K)        &kp LS(X)         &none                    &none            &kp LS(B)      &kp LS(M)         &kp LS(W)           &kp LS(V)  &kp LS(Z)  &none
&none  &none            &none      &kp LS(LEFT_ARROW)  &kp LS(RIGHT)    &none             &none                    &none            &kp LS(ENTER)  &kp LS(UP_ARROW)  &kp LS(DOWN_ARROW)  &none      &none      &none
                                   &none               &bootloader      &none             &none                    &none            &none          &none             &none
            >;
        };

        layer_2 {
            bindings = <
&none        &none         &none         &none         &none         &none         &rgb_ug RGB_TOG    &bt BT_NXT  &bt BT_CLR     &none         &none         &none         &none         &none
&none        &none         &none         &none         &none         &none         &rgb_ug RGB_EFF    &none       &none          &none         &none         &none         &none         &none
&none        &kp NUMBER_7  &kp NUMBER_5  &kp NUMBER_3  &kp NUMBER_1  &kp NUMBER_9  &rgb_ug RGB_BRI    &none       &kp NUMBER_0   &kp NUMBER_2  &kp NUMBER_4  &kp NUMBER_6  &kp NUMBER_8  &none
&none        &none         &none         &none         &none         &none         &rgb_ug RGB_BRD    &none       &kp PAGE_UP    &kp HOME      &kp END       &none         &none         &none
&bootloader  &none         &none         &none         &none         &none         &none              &none       &kp PAGE_DOWN  &none         &none         &none         &none         &bootloader
                                         &none         &bootloader   &none         &none              &none       &kp BACKSPACE  &bootloader   &none
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans       &trans   &trans       &trans     &trans       &bl BL_ON  &bl BL_OFF     &bl BL_INC  &bl BL_DEC  &trans  &trans  &kp LG(A)
&trans  &trans  &trans       &kp F21  &trans       &trans     &trans       &none      &none          &none       &kp F15     &none   &none   &kp LG(F)
&trans  &trans  &kp F19      &kp F20  &kp F18      &trans     &trans       &none      &none          &kp F13     &kp F14     &kp F6  &trans  &kp LG(C)
&trans  &trans  &trans       &trans   &trans       &trans     &trans       &trans     &kp PAGE_UP    &kp HOME    &kp END     &trans  &trans  &kp LG(V)
&trans  &trans  &bootloader  &trans   &trans       &mkp LCLK  &mkp RCLK    &kp F17    &kp PAGE_DOWN  &trans      &trans      &trans  &trans  &trans
                             &trans   &bootloader  &sl 4      &trans       &kp F16    &trans         &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp F1  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F3  &kp F2  &kp F4  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        /*  layer_3 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none    &none  &none  &none   &kp FSLH  &kp ASTERISK  &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &kp N7  &kp N8    &kp N9        &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &kp N4  &kp N5    &kp N6        &none  &none
&none  &none  &none  &none  &none  &none  &to 0    &to 3  &none  &kp N1  &kp N2    &kp N3        &none  &none
&none  &none  &none  &none  &none  &none  &to 1    &none  &none  &none   &kp N0    &none         &none  &none
                                   &none  &to 2    &none  &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
          trackball-bindings = <&tsl>;
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
                trackball-bindings = <&tsl>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                trackball-bindings = <&tmv_fine>;
                
        };*/
    };
};

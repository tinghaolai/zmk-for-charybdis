&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        escc {
            bindings = <&kp ESC>;
            key-positions = <17 18>;
            layers = <0>;
        };
    };

    macros {
        pwd_macro: pwd_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp EXCL &kp LS(A) &kp N &kp A &kp L &kp T &kp H &kp N0 &kp N9 &kp N2 &kp N6 &kp N3 &kp N7>,
                <&macro_press>;

